# Docker Compose interpolation/configuration only. Do not copy this file into
# backend/.env; THAICULTURE_DB_PASSWORD is not a backend Settings field.
THAICULTURE_DB_PASSWORD=replace-with-a-local-compose-password
WEBSITE_INTEGRATION_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
